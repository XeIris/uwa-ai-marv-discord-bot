# Discord bot
TOKEN=your-discord-bot-token
CLIENT_ID=your-discord-application-client-id

# Optional: timeout (ms) for outbound Discord API fetches
DISCORD_FETCH_TIMEOUT_MS=10000

# Comma-separated Discord user IDs allowed to use restricted (dev) commands
ALLOWED_USERS=123456789012345678,234567890123456789

# AI providers
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: path to the GM soundfont for the JAYDON music generator
# (defaults to data/soundfonts/GeneralUser-GS.sf2; fetch with `bun scripts/fetch-soundfont.ts`)
MUSIC_SOUNDFONT_PATH=

# Runtime
NODE_ENV=development

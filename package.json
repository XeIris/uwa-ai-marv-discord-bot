{
  "name": "uwa-ai-marv-discord-bot",
  "version": "1.0.0",
  "description": "AI-only fork of the Silverwolf Discord bot (chat, sessions, usage, image/music generation). No website, games, or economy.",
  "main": "index.ts",
  "scripts": {
    "start": "bun index.ts",
    "dev": "bun --watch index.ts",
    "test": "bun test --parallel --preload ./tests/setup.ts",
    "test:watch": "bun test --watch --preload ./tests/setup.ts",
    "test:isolate": "bun test --isolate --preload ./tests/setup.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "fetch:soundfont": "bun scripts/fetch-soundfont.ts",
    "fetch:constitution": "bun scripts/fetch-constitution.ts",
    "fetch:fonts": "bun scripts/fetch-fonts.ts",
    "seed:committee": "bun scripts/seed-committee.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "discord.js": "^14.27.0",
    "openai": "^7",
    "satori": "^0.33",
    "spessasynth_core": "^4.3.20",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7",
    "globals": "^17.11.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "ws": "^8.21.0"
  }
}

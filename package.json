{
  "name": "uwa-ai-marv-discord-bot",
  "version": "1.0.0",
  "description": "AI-only fork of the Silverwolf Discord bot (chat, sessions, usage, image/music generation). No website, games, or economy.",
  "main": "index.ts",
  "scripts": {
    "start": "bun index.ts",
    "dev": "bun --watch index.ts",
    "test": "bun test --parallel --preload ./tests/setup.ts",
    "test:watch": "bun test --watch --preload ./tests/setup.ts",
    "test:isolate": "bun test --isolate --preload ./tests/setup.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "fetch:soundfont": "bun scripts/fetch-soundfont.ts",
    "fetch:constitution": "bun scripts/fetch-constitution.ts",
    "fetch:fonts": "bun scripts/fetch-fonts.ts",
    "seed:committee": "bun scripts/seed-committee.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@google/generative-ai": "^0.16.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "discord.js": "^14.27.0",
    "mime": "^4",
    "openai": "^5.23.2",
    "satori": "^0.33",
    "spessasynth_core": "^4.3.20",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.6.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "ws": "^8.21.0"
  }
}
